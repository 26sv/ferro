# Copia questo file in `.env.local` e riempilo con i valori del tuo progetto.
# Se le variabili Firebase mancano, l'app parte comunque in modalità demo:
# stessi dati del seed, salvati nel browser invece che su Firestore.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# uid dell'unico account che può leggere e scrivere. Lo stesso valore va
# messo dentro `firestore.rules` prima di pubblicare le regole.
VITE_OWNER_UID=

# URL della web app di Apps Script (deploy "eseguito come me").
VITE_APPS_SCRIPT_URL=

# Stringa lunga a caso, la stessa che sta nelle Proprietà script del progetto
# Apps Script sotto la chiave SEGRETO. Vedi la nota in apps-script/Codice.gs.
VITE_APPS_SCRIPT_SEGRETO=

# id della cartella Drive `/Formazione`, radice di tutto.
VITE_DRIVE_ROOT_ID=
